{
  "package_version": 2,
  "version": "1.0.0",
  "name": "cocos-playable-packer",
  "title": "Cocos Playable Packer",
  "description": "Cocos Creator 3.8.x Playable packaging extension.",
  "author": "wang-yichun",
  "editor": ">=3.8.0 <3.9.0",
  "main": "./dist/main.js",
  "type": "commonjs",
  "panels": {
    "default": {
      "title": "Cocos Playable Packer",
      "type": "dockable",
      "main": "./dist/panels/default",
      "icon": "./static/cocos-playable-packer-tab-icon.svg",
      "flags": { "resizable": true, "save": true },
      "size": { "min-width": 460, "min-height": 600, "width": 720, "height": 820 }
    }
  },
  "contributions": {
    "menu": [
      {
        "path": "i18n:menu.extension/Cocos Playable Packer",
        "label": "打开打包面板",
        "message": "open-panel"
      }
    ],
    "shortcuts": [
      { "message": "open-panel", "win": "alt+f3", "mac": "cmd+f3" }
    ],
    "messages": {
      "open-panel": { "methods": ["openPanel"] },
      "query-environment": { "methods": ["queryEnvironment"] },
      "start-build": { "methods": ["startBuild"] },
      "query-build-task": { "methods": ["queryBuildTask"] },
      "cancel-build": { "methods": ["cancelBuild"] },
      "open-preview": { "methods": ["openPreview"] },
      "open-output-folder": { "methods": ["openOutputFolder"] },
      "read-build-report": { "methods": ["readBuildReport"] },
      "query-loading-logo": { "methods": ["queryLoadingLogo"] },
      "save-loading-logo": { "methods": ["saveLoadingLogo"] },
      "clear-loading-logo": { "methods": ["clearLoadingLogo"] }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json -w"
  }
}
